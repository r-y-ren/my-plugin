# my-plugin 机器档案模板
# 落地位置：~/.config/my-plugin/machine.env（scripts/bootstrap.sh 自动拷贝生成）
# 原则：**事实归档案，流程归技能**——SKILL.md 只写"怎么做"，"这台机器是谁"全在本文件。
# 同人换机：旧机档案照抄即可（远端身份不变）；换人/换拓扑：逐字段改。
# 下列值是本仓首发环境实况（r-y-ren：rypc 轻薄本 → first 性能本 → tower 算力机），作示例保留在注释语义里。

# ── 本机身份（编排机，只做编排不跑重计算）────────────────────
LOCAL_NICK=rypc
LOCAL_DESC='轻薄本 rypc-prod=100.100.0.5'

# ── 远端算力机 1（主力；约定别名 win/wsl，技能命令模板默认这台）──
REMOTE_NICK=first
REMOTE_DESC='Windows + WSL2 Ubuntu 24.04'
REMOTE_GPU='RTX 4070 Laptop，WSL2 CUDA（/dev/dxg + libcuda）'
REMOTE_TAILNET=100.100.0.6        # win/wsl 共用地址（tailnet）
SSH_WIN_HOST=win                  # Windows 侧 ssh 别名（约定名，技能模板靠它）
SSH_WIN_USER=OSS                  # Windows 账户（:22）
SSH_WSL_HOST=wsl                  # WSL 侧 ssh 别名（计算主入口）
SSH_WSL_USER=renyxin              # WSL 账户
SSH_WSL_PORT=2222                 # WSL sshd 端口（与 Windows 的 22 区分）
SSH_WSL_HOSTNAME=                 # 空 = 直连 REMOTE_TAILNET；WSL NAT 时填 localhost
SSH_WSL_JUMP=                     # 空 = 直连；WSL NAT 时填跳板别名（ssh 自动带 ProxyJump）
REMOTE_WSL_DISTRO=Ubuntu          # WSL 发行版名（win 侧拉起 wsl -d <名> 用）
SSH_WSL_SVC=ssh                   # WSL 内 sshd 单元名（链路修复重启用）
SSH_WSL_HOLD=1                    # 1 = 持有器三件套已装（断线根治）；0 = 不装（空闲会回收，唤醒即恢复）
REMOTE_SHARED=0                   # 1 = 共用机（唯一约束=不动他人文件与运行进程，见技能「共用机纪律」）；0 = 独占
REMOTE_NET=headscale              # 组网方式：headscale（NET_* 控制面）/ official-tailnet

# ── 组网前提（主力机走 KVM-Hub 自持 headscale）────────────────
NET_LOGIN_SERVER='https://board:8080'   # headscale 控制面；只写别名永不写 IP
NET_BOARD_HOST=board              # 控制面主机的 hosts/ssh 别名（IP 漂移时改 hosts）

# ── 远端算力机 2（可选；没有就删掉本段。第三台起照本段命名 REMOTE3_* 并扩 bootstrap）──
REMOTE2_NICK=tower
REMOTE2_DESC='Windows 台式（多人共用）+ WSL2 Ubuntu 20.04'
REMOTE2_GPU='RTX 3090 Ti 24G，WSL2 CUDA（/usr/lib/wsl/lib/nvidia-smi）'
REMOTE2_TAILNET=100.107.215.93    # 官方 tailnet
REMOTE2_SSH_WIN_HOST=tower
REMOTE2_SSH_WIN_USER=RESEARCHER   # :22，纯公钥（不持有 Windows 密码）
REMOTE2_SSH_WSL_HOST=towerw
REMOTE2_SSH_WSL_USER=kvmhub
REMOTE2_SSH_WSL_PORT=2222
REMOTE2_SSH_WSL_HOSTNAME=localhost  # WSL NAT：2222 只映射 Windows localhost
REMOTE2_SSH_WSL_JUMP=tower        # 2222 不可从 tailnet 直连 → ProxyJump 进
REMOTE2_WSL_DISTRO=Ubuntu
REMOTE2_SSH_WSL_SVC=kvmhub-sshd   # 独立 sshd 单元（配置/密钥在计算用户家目录）
REMOTE2_WSL_HOLD=1                # 持有器三件套已装（空闲不回收）
REMOTE2_SHARED=1                  # 共用机标记：唯一约束=不动他人文件与运行进程（见技能「共用机纪律」）
REMOTE2_NET=official-tailnet      # 官方 tailnet（链路体检走系统 tailscale）

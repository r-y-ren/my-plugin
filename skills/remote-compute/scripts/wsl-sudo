#!/usr/bin/env bash
# 在算力机 WSL（~/.ssh/config 的 wsl/<NICKw> 别名）上执行 sudo 命令，密码自凭据文件取。
# 用法：wsl-sudo 'systemctl status ssh'                      # 主力机（FW_PASS）
#       wsl-sudo -m tower 'systemctl status kvmhub-sshd'     # 第二台起（FW_PASS_<NICK 大写>）
set -euo pipefail
NICK=""
if [ "${1:-}" = "-m" ]; then NICK="${2:?}"; shift 2; fi
if [ $# -lt 1 ]; then echo "用法: wsl-sudo [-m NICK] '<命令>'" >&2; exit 2; fi
source "$HOME/.config/remote-compute/env"
[ -f "$HOME/.config/my-plugin/machine.env" ] && . "$HOME/.config/my-plugin/machine.env"
# 主力机 = FW_PASS + 别名 wsl；第二台起 = FW_PASS_<NICK 大写> + 别名 <NICKw>（档案 *_SSH_WSL_HOST）
VAR=FW_PASS
HOST=${SSH_WSL_HOST:-wsl}
if [ -n "$NICK" ] && [ "$NICK" != "${REMOTE_NICK:-}" ]; then
  if [ "$NICK" = "${REMOTE2_NICK:-}" ]; then
    VAR="FW_PASS_$(printf %s "$NICK" | tr '[:lower:]' '[:upper:]')"
    HOST=${REMOTE2_SSH_WSL_HOST:-${NICK}w}
  else
    echo "错误：未知算力机 NICK=$NICK（档案里是 ${REMOTE_NICK:-?} / ${REMOTE2_NICK:-无}）" >&2; exit 2
  fi
fi
PASSV=${!VAR:-}
case "$PASSV" in
  \<*|'') echo "错误：请先把 $VAR 填进 ~/.config/remote-compute/env" >&2; exit 2 ;;
esac
# 密码经 base64 过通道，避免特殊字符被远端 shell 解释；
# 整条命令包进 sh -c 作为单一参数，保证 && 链里每一段都提权（命令内避免再用单引号）
b64=$(printf %s "$PASSV" | base64 -w0)
exec ssh "$HOST" "printf %s '$b64' | base64 -d | sudo -S -p '' /bin/sh -c '$1'"

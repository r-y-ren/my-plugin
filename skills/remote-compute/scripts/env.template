# 凭据文件模板：填好后存到 ~/.config/remote-compute/env（chmod 600）
# wsl-sudo 读 FW_PASS；WIN_PASS 仅为 ssh win 密码登录的备援（key 免密后闲置）

# WSL 侧（ssh wsl 里 sudo 用；用户见机器档案 SSH_WSL_USER）
FW_PASS='<WSL 登录密码>'

# Windows 侧（备援；用户见机器档案 SSH_WIN_USER）
WIN_PASS='<Windows 账户密码>'

# 第二台起（可选；变量名 = FW_PASS_<档案 NICK 大写>，wsl-sudo -m <NICK> 用。纯公钥机整段可不设）：
# FW_PASS_TOWER='<该机 WSL 登录密码>'
